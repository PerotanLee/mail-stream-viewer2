ca, sans-serif !important;}\r\n.v {font-family: Georgia, Palatino Linotype, serif !important;}\r\n.t {padding-bottom: 10px !important;}\r\na {color: #222222; text-decoration:underline !important;}\r\n</style>\r\n<![endif]-->\r\n<!--[if gte mso 7]>\r\n<xml>\r\n<o:OfficeDocumentSettings>\r\n<o:AllowPNG/>\r\n<o:PixelsPerInch>96</o:PixelsPerInch>\r\n</o:OfficeDocumentSettings>\r\n</xml>\r\n<![endif]-->\r\n</head>\r\n<body style=\"background-color:#f5f5f5;margin:0 auto;padding:0;text-align:center\" class=\"a\">\r\n<div style=\"display:none;font-size:1px;color:#222;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden\"> Plus: Sentiment slump | Friday, August 14, 2026</div>\r\n<table cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background-color:#f6f6f6;text-align:center\">\r\n<tr>\r\n<td style=\"max-width:600px\">\r\n<!--[if mso]>\r\n<table style=\"width:600px;\">\r\n<tr>\r\n<td>\r\n<![endif]-->\r\n<table style=\"max-width:600px;width:100%;margin:0 auto;text-align:left;background:#fff\" cellspacing=\"0\" cellpadding=\"0\">\r\n<tr>\r\n<td height=\"20\" style=\"height:20px;font-size:0\">&nbsp;</td>\r\n</tr>\r\n<tr>\r\n<td style=\"vertical-align:top\">\r\n<table cellspacing=\"0\" cellpadding=\"0\" width=\"100%\">\r\n<tr>\r\n<td style=\"padding-left:3.5%\">\r\n<a href=\"https://link.axios.com/click/47050214.512785/aHR0cHM6Ly93d3cuYXhpb3MuY29tP3V0bV9zb3VyY2U9bmV3c2xldHRlciZ1dG1fbWVkaXVtPWVtYWlsJnV0bV9jYW1wYWlnbj1uZXdzbGV0dGVyX2F4aW9zbWFjcm8mc3RyZWFtPWJ1c2luZXNz/6a14a774a4e0095e0a03c94aBb904a0dc\" title=\"AXIOS\" target=\"_blank\"> <img src=\"https://static.axios.com/img-email/axios-retina.png\" alt=\"Axios\" width=\"83\" border=\"0\"/> </a> <a href=\"https://link.axios.com/click/47050214.512785/aHR0cDovL3d3dy5heGlvcy5jb20_dXRtX3NvdXJjZT1uZXdzbGV0dGVyJnV0bV9tZWRpdW09ZW1haWwmdXRtX2NhbXBhaWduPW5ld3NsZXR0ZXJfYXhpb3NtYWNybyZzdHJlYW09YnVzaW5lc3M/6a14a774a4e0095e0a03c94aBa4c4bdd8\"><img src=\"https://link.axios.com/img/6a14a774a4e0095e0a03c94as0g6e.azo1/ff168c96.gif\" alt=\"\" border=\"0\" /></a></td>\r\n<td style=\"padding-right:3.5%\" align=\"right\"> <a href=\"https://link.axios.com/click/47050214.512785/aHR0cHM6Ly93d3cuYXhpb3MuY29tL25ld3NsZXR0ZXJzL2F4aW9zLW1hY3JvLTA3NjQ3ZGMwLTk3ZTQtMTFmMS1iZjliLWQ1ZWZjYzk1ODI1Zi5odG1sP3V0bV9zb3VyY2U9bmV3c2xldHRlciZ1dG1fbWVkaXVtPWVtYWlsJnV0bV9jYW1wYWlnbj1uZXdzbGV0dGVyX2F4aW9zbWFjcm8mc3RyZWFtPWJ1c2luZXNz/6a14a774a4e0095e0a03c94aBb7f6351b\" target=\"_blank\" class=\"b\" style=\"color:#222;font-size:13px;font-family:'gordita',Arial,Helvetica,sans-serif;text-decoration:underline\">View in browser</a> </td>\r\n</tr>\r\n</table>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td height=\"30\" style=\"height:30px;font-size:0\">&nbsp;</td>\r\n</tr>  <tr>\r\n<td style=\"text-align:center;line-height:1.3\"> </td>\r\n</tr>\r\n<tr>\r\n<td height=\"16\" style=\"height:16px;font-size:0\">&nbsp;</td>\r\n</tr><tr>\r\n<td style=\"text-align:center;line-height:1\">\r\n<span class=\"s\" style=\"font-size:44px;font-family:'gorditamedium',Arial,Helvetica,sans-serif;color:#008dc8;letter-spacing:-1px;line-height:1\"> Axios Macro </span>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"text-align:center;line-height:1.5;padding-bottom:35px;padding-top:10px\">\r\n<span class=\"b\" style=\"font-size:13px;color:#222;font-family:'gorditamedium',Arial,Helvetica,sans-serif\">By  Neil Irwin and Courtenay Brown  <span style=\"margin:0 6px\">&middot;</span> Aug 14, 2026 </span>\r\n</td>\r\n</tr><tr>\r\n<td class=\"v\" style=\"font-size:17px;font-family:Georgia,serif;line-height:1.75;color:#222;letter-spacing:-0.1px;padding:0 3.5%\"><p><strong>This summer Friday edition</strong> of Macro is focused on the U.S. consumer. And the news isn't great!</p><ul><li>Below, we parse a weak July retail sales number and a drop in consumer sentiment in early data from August.</li></ul><p><em>Today's newsletter, edited by Jeffrey Cane and copy edited by Katie Lewis, is 691 words, a 2.5-minute read.</em></p></td>\r\n</tr><tr>\r\n<td height=\"10\" style=\"height:10px;font-size:0;border-bottom:10px solid #f5f5f5\">&nbsp;</td>\r\n</tr>      <tr>\r\n<td height=\"10\" style=\"height:10px;font-size:0\">&nbsp;</td>\r\n</tr><tr>\r\n<td style=\"padding:20px 3.5% 10px;line-height:1.5\">\r\n<span class=\"b k\" style=\"font-size:27px;font-family:'gorditamedium',Arial,Helvetica,sans-serif;color:#222;letter-spacing:-0.1px;line-height:1.5\">  1 big thing: Surprise retail slump </span>\r\n</td>\r\n</tr>   <tr>\r\n<td height=\"10\" style=\"height:10px;font-size:0\">&nbsp;</td>\r\n</tr> <tr>\r\n<td class=\"v\" style=\"padding:0 3.5%;line-height:1.75;font-size:17px;font-family:Georgia,serif;color:#222;letter-spacing:-0.1px\"><!--[if mso]><img alt='A column chart that shows monthly U.S. retail sales percentage changes from April to July 2026. Sales rose 0.67% in April and 0.93% in May, then slowed to 0.25% in June before falling 0.58% in July. Across the full series, changes ranged from -1.10% to 1.72%.' src='https://graphics.axios.com/hermesv2/2026-08-14-939-u-s-retail-sales/fallbacks/2026-08-14-939-u-s-retail-sales-fallback.png' style='max-width: 100%;' width='558' /><![endif]--><!--[if !mso]><!--><img alt=\"A column chart that shows monthly U.S. retail sales percentage changes from April to July 2026. Sales rose 0.67% in April and 0.93% in May, then slowed to 0.25% in June before falling 0.58% in July. Across the full series, changes ranged from -1.10% to 1.72%.\" src=\"https://graphics.axios.com/hermesv2/2026-08-14-939-u-s-retail-sales/fallbacks/2026-08-14-939-u-s-retail-sales-fallback.png\" style=\"max-width: 100%;\" width=\"100%\"/><!--<![endif]--><div class=\"bodytext\" style=\"font-size:13px; font-family:'Gordita',Arial,Helvetica,sans-serif; color:#848484; margin-bottom:20px;\">Data: <a href=\"https://link.axios.com/click/47050214.512785/aHR0cHM6Ly93d3cuY2Vuc3VzLmdvdi9yZXRhaWwvc2FsZXMuaHRtbD91dG1fc291cmNlPW5ld3NsZXR0ZXImdXRtX21lZGl1bT1lbWFpbCZ1dG1fY2FtcGFpZ249bmV3c2xldHRlcl9heGlvc21hY3JvJnN0cmVhbT1idXNpbmVzcw/6a14a774a4e0095e0a03c94aB57f15842\" target=\"_blank\">Census Bureau</a>; Chart: Neil Irwin/Axios</div><p><strong>American consumers</strong> have <a href=\"https://link.axios.com/click/47050214.512785/aHR0cHM6Ly93d3cuYXhpb3MuY29tLzIwMjYvMDcvMTYvcmV0YWlsLXNhbGVzLWNvbnN1bWVyLXNwZW5kaW5nLWp1bmU_dXRtX3NvdXJjZT1uZXdzbGV0dGVyJnV0bV9tZWRpdW09ZW1haWwmdXRtX2NhbXBhaWduPW5ld3NsZXR0ZXJfYXhpb3NtYWNybyZzdHJlYW09YnVzaW5lc3M/6a14a774a4e0095e0a03c94aB30bf9c1e\" target=\"_blank\">powered the economy</a> forward this year. In July, they took a breather.</p><p><strong>Why it matters: </strong>While the underlying trend in consumer demand appears solid, retail sales hit an air pocket last month, suggesting a bumpier path ahead for overall growth.</p><ul><li>Combined with a <a href=\"https://link.axios.com/click/47050214.512785/aHR0cHM6Ly93d3cuYXhpb3MuY29tLzIwMjYvMDgvMDcvanVseS1qb2JzLXJlcG9ydC1lbXBsb3ltZW50LWxvc3Nlcz91dG1fc291cmNlPW5ld3NsZXR0ZXImdXRtX21lZGl1bT1lbWFpbCZ1dG1fY2FtcGFpZ249bmV3c2xldHRlcl9heGlvc21hY3JvJnN0cmVhbT1idXNpbmVzcw/6a14a774a4e0095e0a03c94aB2b6c484a\" target=\"_blank\">weak jobs report</a> last week and <a href=\"https://link.axios.com/click/47050214.512785/aHR0cHM6Ly93d3cuYXhpb3MuY29tLzIwMjYvMDgvMTIvY3BpLWp1bHktaW5mbGF0aW9uLWlyYW4tdHJ1bXA_dXRtX3NvdXJjZT1uZXdzbGV0dGVyJnV0bV9tZWRpdW09ZW1haWwmdXRtX2NhbXBhaWduPW5ld3NsZXR0ZXJfYXhpb3NtYWNybyZzdHJlYW09YnVzaW5lc3M/6a14a774a4e0095e0a03c94aB421649c1\" target=\"_blank\">two</a> <a href=\"https://link.axios.com/click/47050214.512785/aHR0cHM6Ly93d3cuYXhpb3MuY29tLzIwMjYvMDgvMTMvaW5mbGF0aW9uLWp1bHktcHBpP3V0bV9zb3VyY2U9bmV3c2xldHRlciZ1dG1fbWVkaXVtPWVtYWlsJnV0bV9jYW1wYWlnbj1uZXdzbGV0dGVyX2F4aW9zbWFjcm8mc3RyZWFtPWJ1c2luZXNz/6a14a774a4e0095e0a03c94aB61513c42\" target=\"_blank\">subdued</a> inflation readings this week, it points to the Federal Reserve having room to be patient on potential interest rate increases this fall.</li></ul><p><strong>Driving the news: </strong>Retail sales fell 0.6% in July, the weakest performance in more than a year and well below the 0.1% gain analysts expected.</p><ul><li>Excluding gas stations and auto dealers, there was still a 0.3% decline in sales, meaning that the weakness was evident even apart from those volatile categories.</li><li>Auto dealers' sales were down 2%, gasoline stations' sales fell 0.9%, and electronic and appliance store sales declined 0.5%.</li></ul><p><strong>Of note: </strong>Some one-off shifts pulled the numbers downward. Amazon held its Prime Day discounting event earlier this year than last, helping explain a 2.2% drop in online sales.</p><ul><li>Moreover, most World Cup games took place in June, so the associated spending would have the mechanical effect of pushing retail sales upward in early summer and creating a misleading decline in July.</li></ul><p><strong>Yes, but: </strong>The numbers were soft even accounting for those factors, giving some pause as to how robust consumer spending will be in the second half of the year.</p><ul><li>Growth in Personal Consumption Expenditures contributed a whopping 2.1 percentage points to overall GDP growth in the second quarter, even as other sectors combined to subtract from GDP.</li><li>The retail sales control group that feeds directly into GDP calculations fell 0.4% in July, versus a 0.3% gain that analysts forecast, and previously reported gains for May and June were revised downward.</li></ul><p><strong>What they're saying:</strong> \"The weaker July retail sales report shows that consumers took a breather last month after an ebullient burst of spending in the first half of the year,\" Nationwide chief economist Kathy Bostjancic wrote in a note.</p><ul><li>\"The contraction in core retail control spending last month, following downward revisions to the prior two months, translates into a bit less momentum for real consumer spending starting Q3 than previously expected.\"</li></ul><p><strong>Reality check: </strong>The stock market is booming, gasoline prices are well off their recent highs, and the unemployment rate is low. There is no reason to expect broader consumer spending to experience a meaningful pullback.</p><ul><li>But the July retail numbers suggest there's no major acceleration taking place, either.</li></ul></td>\r\n</tr> <tr><td align=\"center\" style=\"padding:20px 3.5% 25px\">   <a href=\"https://link.axios.com/click/47050214.512785/aHR0cHM6Ly93d3cuZmFjZWJvb2suY29tL3NoYXJlci5waHA_dT1odHRwczovL3d3dy5heGlvcy5jb20vbmV3c2xldHRlcnMvYXhpb3MtbWFjcm8tMDc2NDdkYzAtOTdlNC0xMWYxLWJmOWItZDVlZmNjOTU4MjVmLmh0bWw_Y2h1bmslM0QxJTI2dXRtX3Rlcm0lM0RmYnNvY2lhbHNoYXJlJTIzc3RvcnkxJnV0bV9zb3VyY2U9bmV3c2xldHRlciZ1dG1fbWVkaXVtPWVtYWlsJnV0bV9jYW1wYWlnbj1uZXdzbGV0dGVyX2F4aW9zbWFjcm8mc3RyZWFtPWJ1c2luZXNz/6a14a774a4e0095e0a03c94aBc383d56a\" style=\"display:inline-block\"><img width=\"32\" height=\"32\" style=\"border:0\" src=\"https://static.axios.com/img/axios-site/newsletters/logos/footer/share-facebook-circle-border.png\" alt=\"Share on Facebook\"></a> <a href=\"https://link.axios.com/click/47050214.512785/aHR0cHM6Ly90d2l0dGVyLmNvbS9pbnRlbnQvdHdlZXQ_dGV4dD0xJTIwYmlnJTIwdGhpbmc6JTIwU3VycHJpc2UlMjByZXRhaWwlMjBzbHVtcCZoYXNodGFncz1heGlvc21hY3JvJnVybD1odHRwczovL3d3dy5heGlvcy5jb20vbmV3c2xldHRlcnMvYXhpb3MtbWFjcm8tMDc2NDdkYzAtOTdlNC0xMWYxLWJmOWItZDVlZmNjOTU4MjVmLmh0bWw_Y2h1bmslM0QxJTI2dXRtX3Rlcm0lM0R0d3NvY2lhbHNoYXJlJTIzc3RvcnkxJnV0bV9zb3VyY2U9bmV3c2xldHRlciZ1dG1fbWVkaXVtPWVtYWlsJnV0bV9jYW1wYWlnbj1uZXdzbGV0dGVyX2F4aW9zbWFjcm8mc3RyZWFtPWJ1c2luZXNz/6a14a774a4e0095e0a03c94aB2d813b9b\" style=\"display:inline-block;margin-left:7px\"><img width=\"32\" height=\"32\" style=\"border:0\" src=\"https://static.axios.com/img/axios-site/newsletters/logos/footer/share-x-circle-border.png\" alt=\"Tweet this Story\"></a> <a href=\"https://link.axios.com/click/47050214.\" style=\"display:inline-block;margin-left:7px\"><img width=\"32\" height=\"32\" style=\"border:0\" src=\"https://static.axios.com/img/axios-site/newsletters/logos/footer/share-linkedin-circle-border.png\" alt=\"Post to LinkedIn\"></a>  <a href=\"mailto:?subject=From Axios: 1 big thing: Surprise retail slump&body=teruyuki%40hh.iij4u.or.jp%20has%20shared%20an%20Axios%20story%20with%20you%3A%0A%0A1 big thing: Surprise retail slump%0Ahttps%3A%2F%2Fwww.axios.com%2Fnewsletters%2Faxios-macro-07647dc0-97e4-11f1-bf9b-d5efcc95825f.html%3Fchunk%3D1%26utm_term%3Demshare%23story1\" style=\"display:inline-block;margin-left:7px\"><img width=\"32\" height=\"32\" style=\"border:0\" src=\"https://static.axios.com/img/axios-site/newsletters/logos/footer/share-email-circle-border.png\" alt=\"Email this Story\"></a> <a href=\"https://link.axios.com/click/47050214.\" style=\"display:inline-block;margin-left:7px\"><img width=\"32\" height=\"32\" style=\"border:0\" src=\"https://static.axios.com/img/axios-site/newsletters/logos/footer/share-sms-circle-border.png\" alt=\"Text this Story\"></a></td></tr><tr>\r\n<td height=\"10\" style=\"height:10px;font-size:0;border-bottom:10px solid #f5f5f5\">&nbsp;</td>\r\n</tr>      \r\n<tr><td height=\"20\" style=\"height: 10px; font-size: 0;\">&nbsp;</td></tr><tr><td class=\"ol-adpad\" style=\"padding: 20px 3.5% 0 3.5%;\"><p class=\"b\"\r\nstyle=\"-webkit-text-size-adjust: 100% !important; margin-bottom: 0 !important; font-size: 11px !important; letter-spacing: 1.4px; color: #008dc8; font-weight:700;\"\r\n>\r\nA MESSAGE FROM AXIOS\r\n</p></td></tr>\r\n<tr><td style=\"padding: 20px 3.5%; line-height: 1.5;\"><span class=\"b k\" style=\"font-size: 26px; color: #222222;  font-family: 'gorditamedium', Arial, Helvetica, sans-serif;  letter-spacing: -0.1px; line-height: 1.5;\">Don't Miss: Our Quarterly Report on Ad Economics</span></td></tr>\r\n<tr><td height=\"10\" style=\"height: 10px; font-size: 0;\">&nbsp;</td></tr>\r\n<tr><td>\r\n<a href=\"https://link.axios.com/click/47050214.512785/aHR0cHM6Ly93d3cuYXhpb3MuY29tL21lZGlhLXRyZW5kcy1leGVjdXRpdmU_dXRtX3NvdXJjZT1uZXdzbGV0dGVyJnV0bV9tZWRpdW09YWQmdXRtX2NhbXBhaWduPW10ZV9hY3F1aXNpdGlvbiZ1dG1fYXVkaWVuY2U9bXVsdGkmdXRtX2NvbnRlbnQ9MjAyNjA3UTJyZXBvcnQmc3